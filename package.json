{
  "name": "smashburger-webflow-navbar",
  "version": "0.3.0-rc.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:cdn": "node scripts/build-cdn-loader.mjs",
    "build:dist": "node scripts/build-dist.mjs",
    "build:webflow": "node scripts/build-webflow-embed.mjs",
    "build:canvas": "node scripts/build-canvas-embed.mjs",
    "test": "node --test --test-concurrency=1",
    "test:icon-geometry": "node --test --test-name-pattern='maintained source icon geometry' tests/runtime-delivery.test.js",
    "test:built": "node scripts/check-built-runtime.mjs",
    "check": "node --check src/navbar-light.js",
    "check:dist": "node scripts/check-dist.mjs",
    "test:candidate": "node scripts/check-built-runtime.mjs",
    "check:namespace": "node scripts/check-class-namespace.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "29.0.0"
  }
}
